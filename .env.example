# Environment Configuration for Enterprise Multi-Agent AI System

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Alternative models: gemini-2.5-pro, gemini-1.5-pro, gemini-1.5-flash
GEMINI_FALLBACK_TO_MOCK=true  # Allows full testing & demo execution when API key is not provided

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-multi-agent-system-2025
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./multi_agent_system.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/multi_agent_db

# LangSmith Observability (Optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-gemini-multi-agent

# n8n Automation Integration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/finance-approval
N8N_ENABLED=true
N8N_WEBHOOK_SECRET=n8n-enterprise-secret-key-9988

# Multi-Agent Workflow Budget & Limits
MAX_RETRY_COUNT=2
MAX_TOOL_CALL_BUDGET=25
MAX_EXECUTION_TIME_SECONDS=180
MAX_TOKEN_BUDGET=50000
